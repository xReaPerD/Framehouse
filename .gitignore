node_modules/
.DS_Store
Thumbs.db

# Rendered outputs & HyperFrames caches (large, reproducible)
projects/*/renders/*
!projects/*/renders/.gitkeep
**/.hyperframes/
**/.thumbnails/
**/.waveform-cache/

# Hardlinked asset mirrors — regenerated by `studio sync`
projects/*/cuts/*/assets/shared/

# Heavy source media — remove these lines if you want media in git (consider Git LFS instead)
projects/*/inbox/*
!projects/*/inbox/README.md
*.mov
*.prores

# Private client projects: list them in .git/info/exclude (local only, never published)

# Local tool settings
.claude/settings.local.json
